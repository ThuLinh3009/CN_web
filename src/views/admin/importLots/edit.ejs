<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Sửa lô hàng / Cập nhật giá bán</h3><a href="/admin/import-lots" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <% if (typeof lot !== 'undefined' && lot) { %>
  <form method="POST" action="/admin/import-lots/edit/<%= lot.id %>">
    <div class="form-group"><label>Sách</label><input type="text" value="<%= lot.book_title||'' %>" disabled /></div>
    <div class="form-group"><label>Tồn kho hiện tại</label><input type="text" value="<%= lot.quantity %>" disabled style="background:#f5f5f5;color:#888;" /></div>
    <div class="form-group"><label>Giá bán mới (đ)</label><input type="number" name="sale_price" value="<%= lot.sale_price||'' %>" min="0" step="1000" /></div>
    <div class="form-group"><label>Vị trí kho</label><input type="text" name="location" value="<%= lot.location||'' %>" /></div>
    <div class="form-group"><label>Ghi chú</label><textarea name="note" rows="2"><%= lot.note||'' %></textarea></div>
    <p style="color:#888;font-size:13px;">⚠ Số lượng tồn kho không thể sửa tay — chỉ thay đổi qua phiếu nhập.</p>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Cập nhật</button>
      <a href="/admin/import-lots" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
  <% } %>
</div>
<%- include('../../layouts/admin_bottom') %>
