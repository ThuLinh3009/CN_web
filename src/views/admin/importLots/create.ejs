<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Tạo lô hàng nhập</h3><a href="/admin/import-lots" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <form method="POST" action="/admin/import-lots/create">
    <div class="form-group">
      <label>Sách *</label>
      <select name="book_id" required>
        <option value="">-- Chọn sách --</option>
        <% if (typeof books !== 'undefined' && books) { %>
          <% books.forEach(function(b){ %>
            <option value="<%= b.id %>"><%= b.title %></option>
          <% }); %>
        <% } %>
      </select>
    </div>
    <div class="form-group">
      <label>Nhà cung cấp</label>
      <select name="supplier_id">
        <option value="">-- Chọn NCC --</option>
        <% if (typeof suppliers !== 'undefined' && suppliers) { %>
          <% suppliers.forEach(function(s){ %>
            <option value="<%= s.id %>"><%= s.name %></option>
          <% }); %>
        <% } %>
      </select>
    </div>
    <div class="form-group"><label>Giá bán (đ)</label><input type="number" name="sale_price" min="0" step="1000" /></div>
    <div class="form-group"><label>Vị trí kho</label><input type="text" name="location" placeholder="VD: Kệ A1, Tầng 2..." /></div>
    <div class="form-group"><label>Ghi chú</label><textarea name="note" rows="2"></textarea></div>
    <p style="color:#888;font-size:13px;">⚠ Số lượng tồn kho sẽ được cập nhật khi xác nhận phiếu nhập, không nhập tay ở đây.</p>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Lưu</button>
      <a href="/admin/import-lots" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
</div>
<%- include('../../layouts/admin_bottom') %>
