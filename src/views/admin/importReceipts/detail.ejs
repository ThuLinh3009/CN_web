<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header">
  <h3>Chi tiết phiếu nhập</h3>
  <div>
    <a href="/admin/import-receipts" class="btn btn-secondary">&larr; Quay lại</a>
    <a href="/admin/import-receipts/print/<%= receipt && receipt.id %>" class="btn btn-info" style="margin-left:8px;">In phiếu</a>
    <% if (typeof receipt !== 'undefined' && receipt && receipt.status !== 'confirmed') { %>
      <form method="POST" action="/admin/import-receipts/<%= receipt.id %>/confirm" style="display:inline;margin-left:8px;" onsubmit="return confirm('Xác nhận phiếu nhập này?')">
        <button type="submit" class="btn btn-success">Xác nhận nhập</button>
      </form>
    <% } %>
  </div>
</div>
<% if (typeof receipt !== 'undefined' && receipt) { %>
<div class="card" style="max-width:700px;margin-bottom:16px;">
  <table>
    <tr><th style="width:180px;">Mã phiếu</th><td><strong><%= receipt.receipt_code||receipt.id %></strong></td></tr>
    <tr><th>Nhân viên</th><td><%= receipt.employee_name||'' %></td></tr>
    <tr><th>Nhà cung cấp</th><td><%= receipt.supplier_name||'' %></td></tr>
    <tr><th>Trạng thái</th><td><% if(receipt.status==='confirmed'){ %><span class="badge badge-success">Đã xác nhận</span><% } else { %><span class="badge badge-warning">Chờ xác nhận</span><% } %></td></tr>
    <tr><th>Ghi chú</th><td><%= receipt.note||'' %></td></tr>
    <tr><th>Ngày tạo</th><td><%= receipt.created_at ? new Date(receipt.created_at).toLocaleString('vi-VN') : '' %></td></tr>
  </table>
</div>
<div class="card" style="overflow-x:auto;">
  <h4 style="margin-bottom:12px;">Danh sách sách nhập</h4>
  <table>
    <thead><tr><th>#</th><th>Tên sách</th><th>Lô hàng</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
    <tbody>
      <% if (receipt.items && receipt.items.length) { %>
        <% var total = 0; %>
        <% receipt.items.forEach(function(item, idx){ total += (item.quantity||0)*(item.unit_price||0); %>
          <tr>
            <td><%= idx+1 %></td>
            <td><%= item.book_title||'' %></td>
            <td>Lô #<%= item.lot_id %></td>
            <td><%= item.quantity %></td>
            <td><%= Number(item.unit_price||0).toLocaleString('vi-VN') %>đ</td>
            <td><%= Number((item.quantity||0)*(item.unit_price||0)).toLocaleString('vi-VN') %>đ</td>
          </tr>
        <% }); %>
        <tr style="font-weight:bold;background:#f5f5f5;"><td colspan="5" style="text-align:right;">Tổng cộng:</td><td><%= Number(total).toLocaleString('vi-VN') %>đ</td></tr>
      <% } else { %><tr><td colspan="6" style="text-align:center;">Chưa có sách</td></tr><% } %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../../layouts/admin_bottom') %>
