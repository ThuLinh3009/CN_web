<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Sửa thuộc tính sách</h3><a href="/admin/book-attributes" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <% if (typeof attribute !== 'undefined' && attribute) { %>
  <form method="POST" action="/admin/book-attributes/edit/<%= attribute.id %>">
    <div class="form-group"><label>Tên thuộc tính *</label><input type="text" name="name" value="<%= attribute.name %>" required /></div>
    <div class="form-group"><label>Mô tả</label><textarea name="description" rows="3"><%= attribute.description||'' %></textarea></div>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Cập nhật</button>
      <a href="/admin/book-attributes" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
  <% } %>
</div>
<%- include('../../layouts/admin_bottom') %>
