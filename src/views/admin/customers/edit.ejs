<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Sửa khách hàng</h3><a href="/admin/customers" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <% if (typeof customer !== 'undefined' && customer) { %>
  <form method="POST" action="/admin/customers/edit/<%= customer.id %>">
    <div class="form-group"><label>Họ và tên *</label><input type="text" name="full_name" value="<%= customer.full_name %>" required /></div>
    <div class="form-group"><label>Số điện thoại</label><input type="text" name="phone" value="<%= customer.phone||'' %>" /></div>
    <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= customer.email||'' %>" /></div>
    <div class="form-group"><label>Địa chỉ</label><input type="text" name="address" value="<%= customer.address||'' %>" /></div>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Cập nhật</button>
      <a href="/admin/customers" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
  <% } %>
</div>
<%- include('../../layouts/admin_bottom') %>
