<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Quản lý khách hàng</h3><a href="/admin/customers/create" class="btn btn-success">+ Thêm KH</a></div>
<div class="card" style="overflow-x:auto;">
  <table>
    <thead><tr><th>ID</th><th>Họ tên</th><th>SĐT</th><th>Email</th><th>Địa chỉ</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead>
    <tbody>
      <% if (typeof customers !== 'undefined' && customers && customers.length) { %>
        <% customers.forEach(function(c){ %>
          <tr>
            <td><%= c.id %></td>
            <td><strong><%= c.full_name %></strong></td>
            <td><%= c.phone||'' %></td>
            <td><%= c.email||'' %></td>
            <td><%= c.address||'' %></td>
            <td><%= c.created_at ? new Date(c.created_at).toLocaleDateString('vi-VN') : '' %></td>
            <td>
              <a href="/admin/customers/edit/<%= c.id %>" class="btn btn-warning">Sửa</a>
              <form method="POST" action="/admin/customers/delete/<%= c.id %>" style="display:inline" onsubmit="return confirm('Xác nhận xóa khách hàng này?')"><button type="submit" class="btn btn-danger">Xóa</button></form>
            </td>
          </tr>
        <% }); %>
      <% } else { %><tr><td colspan="7" style="text-align:center;padding:20px;">Chưa có khách hàng</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../../layouts/admin_bottom') %>
