<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Sửa nhân viên</h3><a href="/admin/employees" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <% if (typeof employee !== 'undefined' && employee) { %>
  <form method="POST" action="/admin/employees/edit/<%= employee.id %>">
    <div class="form-group"><label>Họ và tên *</label><input type="text" name="full_name" value="<%= employee.full_name %>" required /></div>
    <div class="form-group"><label>Username</label><input type="text" value="<%= employee.username %>" disabled /></div>
    <div class="form-group"><label>Mật khẩu mới (để trống nếu không đổi)</label><input type="password" name="password" /></div>
    <div class="form-group"><label>Số điện thoại</label><input type="text" name="phone" value="<%= employee.phone||'' %>" /></div>
    <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= employee.email||'' %>" /></div>
    <div class="form-group">
      <label>Vai trò *</label>
      <select name="role_id" required>
        <% if (typeof roles !== 'undefined' && roles) { %>
          <% roles.forEach(function(r){ %>
            <option value="<%= r.id %>" <%= employee.role_id===r.id?'selected':'' %>><%= r.name %></option>
          <% }); %>
        <% } %>
      </select>
    </div>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Cập nhật</button>
      <a href="/admin/employees" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
  <% } %>
</div>
<%- include('../../layouts/admin_bottom') %>
