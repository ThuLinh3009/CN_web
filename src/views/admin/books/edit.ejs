<%- include('../../layouts/admin_top', {title: title}) %>

<div class="page-header">
  <h3>Chỉnh sửa sách</h3>
  <a href="/admin/books" class="btn btn-secondary">&larr; Quay lại</a>
</div>

<div class="card" style="max-width:700px;">
  <% if (typeof book !== 'undefined' && book) { %>
  <form method="POST" action="/admin/books/edit/<%= book.id %>">
    <div class="form-group">
      <label>Tên sách *</label>
      <input type="text" name="title" value="<%= book.title %>" required />
    </div>
    <div class="form-group">
      <label>Tác giả</label>
      <input type="text" name="author" value="<%= book.author || '' %>" />
    </div>
    <div class="form-group">
      <label>Thể loại</label>
      <select name="category_id">
        <option value="">-- Chọn thể loại --</option>
        <% if (typeof categories !== 'undefined' && categories) { %>
          <% categories.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= String(book.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        <% } %>
      </select>
    </div>
    <div class="form-group">
      <label>Số lượng</label>
      <input type="number" name="quantity" value="<%= book.quantity || 0 %>" min="0" />
    </div>
    <div class="form-group">
      <label>Tên file ảnh</label>
      <input type="text" name="thumbnail" value="<%= book.thumbnail || '' %>" />
      <% if (book.thumbnail) { %>
        <img src="/images/<%= book.thumbnail %>" style="width:80px;height:90px;object-fit:cover;margin-top:8px;border-radius:3px;" onerror="this.style.display='none'" />
      <% } %>
    </div>
    <div class="form-group">
      <label>Mô tả</label>
      <textarea name="description" rows="4"><%= book.description || '' %></textarea>
    </div>
    <div class="form-group">
      <label>Trạng thái</label>
      <select name="is_active">
        <option value="1" <%= book.is_active ? 'selected' : '' %>>Đang bán</option>
        <option value="0" <%= !book.is_active ? 'selected' : '' %>>Ẩn</option>
      </select>
    </div>
    <div style="margin-top:15px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;font-size:14px;">Cập nhật</button>
      <a href="/admin/books" class="btn btn-secondary" style="padding:8px 20px;font-size:14px;margin-left:10px;">Hủy</a>
    </div>
  </form>
  <% } %>
</div>

<%- include('../../layouts/admin_bottom') %>
