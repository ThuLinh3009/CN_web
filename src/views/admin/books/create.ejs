<%- include('../../layouts/admin_top', {title: title}) %>

<div class="page-header">
  <h3>Thêm sách mới</h3>
  <a href="/admin/books" class="btn btn-secondary">&larr; Quay lại</a>
</div>

<div class="card" style="max-width:700px;">
  <form method="POST" action="/admin/books/create" enctype="multipart/form-data">
    <div class="form-group">
      <label>Tên sách *</label>
      <input type="text" name="title" required />
    </div>
    <div class="form-group">
      <label>Tác giả</label>
      <input type="text" name="author" />
    </div>
    <div class="form-group">
      <label>Thể loại</label>
      <select name="category_id">
        <option value="">-- Chọn thể loại --</option>
        <% if (typeof categories !== 'undefined' && categories) { %>
          <% categories.forEach(function(c){ %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }); %>
        <% } %>
      </select>
    </div>
    <div class="form-group">
      <label>Số lượng</label>
      <input type="number" name="quantity" value="0" min="0" />
    </div>
    <div class="form-group">
      <label>Tên file ảnh (VD: ma1.jpg)</label>
      <input type="text" name="thumbnail" placeholder="VD: ma1.jpg, vh-nn1.jfif..." />
    </div>
    <div class="form-group">
      <label>Mô tả</label>
      <textarea name="description" rows="4"></textarea>
    </div>
    <div class="form-group">
      <label>Trạng thái</label>
      <select name="is_active">
        <option value="1">Đang bán</option>
        <option value="0">Ẩn</option>
      </select>
    </div>
    <div style="margin-top:15px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;font-size:14px;">Lưu sách</button>
      <a href="/admin/books" class="btn btn-secondary" style="padding:8px 20px;font-size:14px;margin-left:10px;">Hủy</a>
    </div>
  </form>
</div>

<%- include('../../layouts/admin_bottom') %>
