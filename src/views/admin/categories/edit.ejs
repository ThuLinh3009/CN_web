<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Chỉnh sửa thể loại</h3><a href="/admin/categories" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <% if (typeof category !== 'undefined' && category) { %>
  <form method="POST" action="/admin/categories/edit/<%= category.id %>">
    <div class="form-group"><label>Tên thể loại *</label><input type="text" name="name" value="<%= category.name %>" required /></div>
    <div class="form-group"><label>Mô tả</label><textarea name="description" rows="3"><%= category.description || '' %></textarea></div>
    <div class="form-group">
      <label>Trạng thái</label>
      <select name="is_active">
        <option value="1" <%= category.is_active ? 'selected' : '' %>>Hoạt động</option>
        <option value="0" <%= !category.is_active ? 'selected' : '' %>>Ẩn</option>
      </select>
    </div>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Cập nhật</button>
      <a href="/admin/categories" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
  <% } %>
</div>
<%- include('../../layouts/admin_bottom') %>
