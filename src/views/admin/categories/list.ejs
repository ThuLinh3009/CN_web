<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header">
  <h3>Quản lý thể loại</h3>
  <a href="/admin/categories/create" class="btn btn-success">+ Thêm thể loại</a>
</div>
<div class="card" style="overflow-x:auto;">
  <table>
    <thead><tr><th>ID</th><th>Tên thể loại</th><th>Mô tả</th><th>Số sách</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
    <tbody>
      <% if (typeof categories !== 'undefined' && categories && categories.length) { %>
        <% categories.forEach(function(c){ %>
          <tr>
            <td><%= c.id %></td>
            <td><strong><%= c.name %></strong></td>
            <td><%= c.description || '' %></td>
            <td><%= c.book_count || 0 %></td>
            <td><span class="badge <%= c.is_active ? 'badge-success' : 'badge-danger' %>"><%= c.is_active ? 'Hoạt động' : 'Ẩn' %></span></td>
            <td>
              <a href="/admin/categories/edit/<%= c.id %>" class="btn btn-warning">Sửa</a>
              <form method="POST" action="/admin/categories/delete/<%= c.id %>" style="display:inline" onsubmit="return confirm('Xác nhận?')">
                <button type="submit" class="btn btn-danger">Xóa</button>
              </form>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6" style="text-align:center;padding:20px;">Chưa có thể loại</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../layouts/admin_bottom') %>
