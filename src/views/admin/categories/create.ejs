<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header"><h3>Thêm thể loại mới</h3><a href="/admin/categories" class="btn btn-secondary">&larr; Quay lại</a></div>
<div class="card" style="max-width:500px;">
  <form method="POST" action="/admin/categories/create">
    <div class="form-group"><label>Tên thể loại *</label><input type="text" name="name" required /></div>
    <div class="form-group"><label>Mô tả</label><textarea name="description" rows="3"></textarea></div>
    <div style="margin-top:12px;">
      <button type="submit" class="btn btn-success" style="padding:8px 20px;">Lưu</button>
      <a href="/admin/categories" class="btn btn-secondary" style="padding:8px 20px;margin-left:8px;">Hủy</a>
    </div>
  </form>
</div>
<%- include('../../layouts/admin_bottom') %>
