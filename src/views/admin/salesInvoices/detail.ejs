<%- include('../../layouts/admin_top', {title: title}) %>
<div class="page-header">
  <h3>Chi tiết hóa đơn bán hàng</h3>
  <div>
    <a href="/admin/sales-invoices" class="btn btn-secondary">&larr; Quay lại</a>
    <a href="/admin/sales-invoices/print/<%= invoice && invoice.id %>" class="btn btn-info" style="margin-left:8px;">In hóa đơn</a>
  </div>
</div>
<% if (typeof invoice !== 'undefined' && invoice) { %>
<div class="card" style="max-width:700px;margin-bottom:16px;">
  <table>
    <tr><th style="width:200px;">Mã hóa đơn</th><td><strong><%= invoice.invoice_code||invoice.id %></strong></td></tr>
    <tr><th>Khách hàng</th><td><%= invoice.customer_name||'Khách lẻ' %></td></tr>
    <tr><th>Nhân viên</th><td><%= invoice.employee_name||'' %></td></tr>
    <tr><th>Hình thức TT</th><td><%= invoice.payment_method==='transfer'?'Chuyển khoản':'Tiền mặt' %></td></tr>
    <tr><th>Trạng thái TT</th><td><% if(invoice.payment_status==='paid'){ %><span class="badge badge-success">Đã thanh toán</span><% } else { %><span class="badge badge-warning">Chưa thanh toán</span><% } %></td></tr>
    <tr><th>Ghi chú</th><td><%= invoice.note||'' %></td></tr>
    <tr><th>Ngày tạo</th><td><%= invoice.created_at ? new Date(invoice.created_at).toLocaleString('vi-VN') : '' %></td></tr>
  </table>
</div>
<div class="card" style="overflow-x:auto;">
  <h4 style="margin-bottom:12px;">Danh sách sách bán</h4>
  <table>
    <thead><tr><th>#</th><th>Tên sách</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
    <tbody>
      <% if (typeof items !== 'undefined' && items && items.length) { %>
        <% var total = 0; %>
        <% items.forEach(function(item, idx){ total += (item.quantity||0)*(item.unit_price||0); %>
          <tr>
            <td><%= idx+1 %></td>
            <td><%= item.book_title||'' %></td>
            <td style="text-align:center;"><%= item.quantity %></td>
            <td style="text-align:right;"><%= Number(item.unit_price||0).toLocaleString('vi-VN') %>đ</td>
            <td style="text-align:right;"><%= Number((item.quantity||0)*(item.unit_price||0)).toLocaleString('vi-VN') %>đ</td>
          </tr>
        <% }); %>
        <tr style="font-weight:bold;background:#f5f5f5;"><td colspan="4" style="text-align:right;">Tổng cộng:</td><td style="text-align:right;"><%= Number(total).toLocaleString('vi-VN') %>đ</td></tr>
      <% } else { %><tr><td colspan="5" style="text-align:center;">Chưa có sách</td></tr><% } %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../../layouts/admin_bottom') %>
