<%- include('../../layouts/main_top', {title: title}) %>

<div style="max-width:900px;margin:40px auto;padding:0 20px;">
  <h1 style="color:#417505;border-bottom:2px solid #417505;padding-bottom:10px;">Lịch sử đơn hàng</h1>

  <% if (typeof orders !== 'undefined' && orders && orders.length) { %>
    <table style="width:100%;border-collapse:collapse;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <thead>
        <tr style="background:#417505;color:#fff;">
          <th style="padding:10px 12px;text-align:left;">Mã đơn</th>
          <th style="padding:10px 12px;">Ngày đặt</th>
          <th style="padding:10px 12px;">Tổng tiền</th>
          <th style="padding:10px 12px;">Thanh toán</th>
          <th style="padding:10px 12px;">Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function(order){ %>
          <tr style="border-bottom:1px solid #eee;">
            <td style="padding:10px 12px;font-weight:bold;color:#417505;"><%= order.code %></td>
            <%
              var d = new Date(order.created_at);
              var dateStr = d.getDate().toString().padStart(2,'0') + '/' + (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getFullYear();
            %>
            <td style="padding:10px 12px;text-align:center;"><%= dateStr %></td>
            <td style="padding:10px 12px;text-align:center;color:red;font-weight:bold;"><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</td>
            <td style="padding:10px 12px;text-align:center;">
              <span style="padding:3px 8px;border-radius:3px;font-size:12px;background:<%= order.payment_status==='paid'?'#d4edda':'#fff3cd' %>;color:<%= order.payment_status==='paid'?'#155724':'#856404' %>;">
                <%= order.payment_status === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán' %>
              </span>
            </td>
            <td style="padding:10px 12px;text-align:center;">
              <span style="padding:3px 8px;border-radius:3px;font-size:12px;background:#e2f0d9;color:#417505;">
                <%
                var statusMap = {pending:'Chờ xác nhận',confirmed:'Đã xác nhận',shipping:'Đang giao',delivered:'Đã giao',cancelled:'Đã hủy'};
                var statusLabel = statusMap[order.status] || order.status;
              %>
              <%= statusLabel %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <div style="text-align:center;padding:60px;">
      <p style="color:#666;font-size:16px;">Bạn chưa có đơn hàng nào.</p>
      <a href="/books" style="display:inline-block;margin-top:15px;padding:11px 25px;background:#417505;color:#fff;text-decoration:none;border-radius:4px;">Mua sắm ngay</a>
    </div>
  <% } %>

  <div style="margin-top:20px;">
    <a href="/profile" style="color:#417505;">&#8592; Quay lại thông tin cá nhân</a>
  </div>
</div>

<%- include('../../layouts/main_bottom') %>
