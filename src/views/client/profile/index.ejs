<%- include('../../layouts/main_top', {title: title}) %>

<div style="max-width:700px;margin:40px auto;padding:0 20px;">
  <h1 style="color:#417505;border-bottom:2px solid #417505;padding-bottom:10px;">Thông tin cá nhân</h1>

  <%- include('../../partials/flash-message') %>

  <% if (typeof profile !== 'undefined' && profile) { %>
    <form method="POST" action="/profile" style="background:#fff;padding:30px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <div style="margin-bottom:12px;">
        <label style="display:block;font-weight:bold;margin-bottom:4px;">Họ và tên</label>
        <input type="text" name="full_name" value="<%= profile.full_name %>" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
      </div>
      <div style="margin-bottom:12px;">
        <label style="display:block;font-weight:bold;margin-bottom:4px;">Tên đăng nhập</label>
        <input type="text" value="<%= profile.username %>" disabled style="width:100%;padding:9px;border:1px solid #ddd;background:#f5f5f5;border-radius:4px;box-sizing:border-box;" />
      </div>
      <div style="margin-bottom:12px;">
        <label style="display:block;font-weight:bold;margin-bottom:4px;">Email</label>
        <input type="email" name="email" value="<%= profile.email || '' %>" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
      </div>
      <div style="margin-bottom:12px;">
        <label style="display:block;font-weight:bold;margin-bottom:4px;">Số điện thoại</label>
        <input type="text" name="phone" value="<%= profile.phone || '' %>" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
      </div>
      <div style="margin-bottom:12px;">
        <label style="display:block;font-weight:bold;margin-bottom:4px;">Địa chỉ</label>
        <input type="text" name="address" value="<%= profile.address || '' %>" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
      </div>
      <div style="display:flex;gap:15px;flex-wrap:wrap;">
        <button type="submit" style="padding:10px 25px;background:#417505;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">Cập nhật</button>
        <a href="/profile/orders" style="padding:10px 25px;background:#f7941e;color:#fff;text-decoration:none;border-radius:4px;font-weight:bold;">Lịch sử đơn hàng</a>
      </div>
    </form>
  <% } %>
</div>

<%- include('../../layouts/main_bottom') %>
