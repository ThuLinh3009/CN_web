<%- include('../../layouts/main_top', {title: title}) %>
<div style="max-width:500px;margin:50px auto;background:#fff;padding:30px;border-radius:8px;box-shadow:0 2px 12px rgba(0,0,0,.1);">
  <h2 style="text-align:center;color:#417505;margin-bottom:20px;">ĐĂNG KÝ TÀI KHOẢN</h2>

  <%- include('../../partials/flash-message') %>

  <form method="POST" action="/register">
    <div style="margin-bottom:12px;">
      <label style="display:block;font-weight:bold;margin-bottom:4px;">Họ và tên *</label>
      <input type="text" name="full_name" required style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
    </div>
    <div style="margin-bottom:12px;">
      <label style="display:block;font-weight:bold;margin-bottom:4px;">Tên đăng nhập *</label>
      <input type="text" name="username" required style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
    </div>
    <div style="margin-bottom:12px;">
      <label style="display:block;font-weight:bold;margin-bottom:4px;">Mật khẩu *</label>
      <input type="password" name="password" required style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
    </div>
    <div style="margin-bottom:12px;">
      <label style="display:block;font-weight:bold;margin-bottom:4px;">Email</label>
      <input type="email" name="email" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
    </div>
    <div style="margin-bottom:12px;">
      <label style="display:block;font-weight:bold;margin-bottom:4px;">Số điện thoại</label>
      <input type="text" name="phone" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
    </div>
    <div style="margin-bottom:12px;">
      <label style="display:block;font-weight:bold;margin-bottom:4px;">Địa chỉ</label>
      <input type="text" name="address" style="width:100%;padding:9px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;" />
    </div>
    <button type="submit" style="width:100%;padding:12px;background:#417505;color:#fff;border:none;border-radius:4px;font-size:16px;cursor:pointer;font-weight:bold;">
      ĐĂNG KÝ
    </button>
  </form>
  <p style="text-align:center;margin-top:15px;font-size:14px;">
    Đã có tài khoản? <a href="/login" style="color:#417505;font-weight:bold;">Đăng nhập</a>
  </p>
</div>
<%- include('../../layouts/main_bottom') %>
