<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'TBook Store' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<%- include('../partials/navbar') %>
<main><%- body %></main>
<%- include('../partials/footer') %>
<script>
// Slideshow
(function(){
  var idx = 0;
  var slides = document.querySelectorAll('.slide');
  if (!slides.length) return;
  function show(i){ slides.forEach(function(s,n){ s.style.display = n===i?'block':'none'; }); }
  show(0);
  setInterval(function(){ idx=(idx+1)%slides.length; show(idx); }, 3000);
})();
// Tab
function showTab(type){
  document.querySelectorAll('.tab').forEach(function(t){ t.classList.remove('active'); });
  document.querySelectorAll('.tab-content').forEach(function(c){ c.style.display='none'; });
  var btn = document.querySelector('.tab[onclick*="'+type+'"]');
  if(btn) btn.classList.add('active');
  var el = document.getElementById('tab-'+type);
  if(el) el.style.display='flex';
}
</script>
</body>
</html>
