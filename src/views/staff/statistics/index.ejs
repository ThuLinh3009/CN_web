<%- include('../../layouts/staff_top', {title: title}) %>
<div class="page-header">
  <h3>Thống kê bán hàng online</h3>
  <form method="GET" action="/staff/statistics" style="display:flex;gap:8px;align-items:center;">
    <label style="font-weight:bold;margin:0;">Năm:</label>
    <select name="year" class="form-control" style="width:auto;" onchange="this.form.submit()">
      <% var currentYear = new Date().getFullYear(); %>
      <% for(var y = currentYear; y >= currentYear - 4; y--) { %>
        <option value="<%= y %>" <%= year===y?'selected':'' %>><%= y %></option>
      <% } %>
    </select>
  </form>
</div>

<%# 3 card tổng quan %>
<div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:24px;">
  <div class="card" style="flex:1;min-width:200px;text-align:center;">
    <div style="font-size:28px;font-weight:bold;color:#417505;">
      <%= typeof stats !== 'undefined' && stats ? Number(stats.totalRevenue||0).toLocaleString('vi-VN') : '0' %>đ
    </div>
    <div style="color:#666;margin-top:4px;">Tổng doanh thu (đã giao)</div>
  </div>
  <div class="card" style="flex:1;min-width:200px;text-align:center;">
    <div style="font-size:28px;font-weight:bold;color:#2980b9;">
      <%= typeof stats !== 'undefined' && stats ? stats.totalOrders||0 : 0 %>
    </div>
    <div style="color:#666;margin-top:4px;">Tổng đơn đã giao</div>
  </div>
  <div class="card" style="flex:1;min-width:200px;text-align:center;">
    <div style="font-size:28px;font-weight:bold;color:#e67e22;">
      <%= typeof stats !== 'undefined' && stats ? Number(stats.revenueThisMonth||0).toLocaleString('vi-VN') : '0' %>đ
    </div>
    <div style="color:#666;margin-top:4px;">Doanh thu tháng này</div>
  </div>
</div>

<div style="display:flex;gap:16px;flex-wrap:wrap;">
  <%# Top sách bán chạy %>
  <div class="card" style="flex:1;min-width:300px;">
    <h4 style="margin-bottom:12px;">Top 10 sách bán chạy</h4>
    <table>
      <thead>
        <tr><th>#</th><th>Tên sách</th><th style="text-align:center;">Đã bán</th><th style="text-align:right;">Doanh thu</th></tr>
      </thead>
      <tbody>
        <% if (typeof topBooks !== 'undefined' && topBooks && topBooks.length) { %>
          <% topBooks.forEach(function(b, idx){ %>
            <tr>
              <td><%= idx+1 %></td>
              <td><%= b.title %></td>
              <td style="text-align:center;"><strong><%= b.sold_qty||0 %></strong></td>
              <td style="text-align:right;"><%= Number(b.revenue||0).toLocaleString('vi-VN') %>đ</td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="4" style="text-align:center;padding:16px;">Chưa có dữ liệu</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%# Doanh thu theo tháng %>
  <div class="card" style="flex:1;min-width:300px;">
    <h4 style="margin-bottom:12px;">Doanh thu theo tháng (<%= year %>)</h4>
    <table>
      <thead>
        <tr><th>Tháng</th><th style="text-align:right;">Doanh thu</th><th style="text-align:center;">Số đơn</th></tr>
      </thead>
      <tbody>
        <% if (typeof monthlyRevenue !== 'undefined' && monthlyRevenue && monthlyRevenue.length) { %>
          <% monthlyRevenue.forEach(function(m){ %>
            <tr>
              <td>Tháng <%= m.month %></td>
              <td style="text-align:right;"><%= Number(m.revenue||0).toLocaleString('vi-VN') %>đ</td>
              <td style="text-align:center;"><%= m.order_count||0 %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="3" style="text-align:center;padding:16px;">Chưa có dữ liệu trong năm <%= year %></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../../layouts/staff_bottom') %>
