<%- include('../../layouts/staff_top', {title: title}) %>
<div class="page-header"><h3>Phiếu nhập hàng</h3><a href="/staff/import-receipts/create" class="btn btn-success">+ Tạo phiếu nhập</a></div>
<div class="card" style="overflow-x:auto;">
  <table>
    <thead><tr><th>Mã phiếu</th><th>Tổng tiền</th><th>Trạng thái</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead>
    <tbody>
      <% if (typeof receipts !== 'undefined' && receipts && receipts.length) { %>
        <% receipts.forEach(function(r){ %>
          <tr>
            <td><strong><%= r.receipt_code||r.id %></strong></td>
            <td><%= r.total_amount ? Number(r.total_amount).toLocaleString('vi-VN') + 'đ' : '0đ' %></td>
            <td>
              <% if(r.status==='confirmed'){ %>
                <span class="badge badge-success">Đã xác nhận</span>
              <% } else { %>
                <span class="badge badge-warning">Chờ xác nhận</span>
              <% } %>
            </td>
            <td><%= r.created_at ? new Date(r.created_at).toLocaleDateString('vi-VN') : '' %></td>
            <td>
              <a href="/staff/import-receipts/<%= r.id %>" class="btn btn-info">Chi tiết</a>
              <a href="/staff/import-receipts/<%= r.id %>/print" class="btn btn-secondary">In</a>
            </td>
          </tr>
        <% }); %>
      <% } else { %><tr><td colspan="5" style="text-align:center;padding:20px;">Chưa có phiếu nhập</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../../layouts/staff_bottom') %>
